{
  "name": "manabu",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @manabu/web dev",
    "test": "pnpm -r test",
    "lint": "oxlint -c oxlint.json apps/ packages/",
    "format": "oxfmt --write 'apps/**' 'packages/**' '!**/node_modules/**' '!**/styled-system/**' '!**/dist/**' '!**/routeTree.gen.ts'",
    "format:check": "oxfmt --check 'apps/**' 'packages/**' '!**/node_modules/**' '!**/styled-system/**' '!**/dist/**' '!**/routeTree.gen.ts'",
    "storybook": "pnpm --filter @manabu/ui storybook",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm format:check"
  },
  "devDependencies": {
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "simple-git-hooks": "^2.13.1"
  }
}
