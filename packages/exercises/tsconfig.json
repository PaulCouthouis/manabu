{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "~/*": ["./src/*"],
      "styled-system/*": ["../ui/styled-system/*"]
    }
  },
  "references": [{ "path": "../shared" }, { "path": "../ui" }],
  "include": ["src"],
  "exclude": ["src/**/*.stories.tsx", "src/__stories__", "src/__tests__", "src/test-utils"]
}
